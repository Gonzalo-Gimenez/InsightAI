GROQ_API_KEY=
GROQ_MODEL=

# Optional: managed Postgres (Render). Overrides POSTGRES_* when set.
DATABASE_URL=

# Comma-separated origins for the Next.js frontend (production).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=insight_ai
POSTGRES_USER=insight_ai
POSTGRES_PASSWORD=

# Optional read-only role for validated SELECT tool (local Docker init creates insight_ai_ro).
POSTGRES_RO_USER=insight_ai_ro
POSTGRES_RO_PASSWORD=insight_ai_ro_demo